// roqit Billing — internal recurring-payment tracker
//
// This replaces the old customer-billing model. The company (ROQIT) uses this
// to track the vendors/services IT PAYS every month (GitHub, AWS, Flespi,
// Twilio, …) — exactly like the "ROQIT_Recurring_Payment_Tracker" spreadsheet,
// but multi-user, with roles, and a searchable document library.
//
// NOTE: enum-like fields are stored as plain strings (allowed values live in
// src/lib/constants.ts). This keeps the model portable and easy to evolve; it
// can be tightened to native Postgres enums later if desired.
//
// Money is stored as integer minor units (paise for INR, cents for USD/EUR) to
// avoid floating-point rounding. See src/lib/money.ts.
//
// Database: PostgreSQL. Set DATABASE_URL to your managed Postgres connection
// string (Neon/Supabase). For local dev you can point it at the same database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Office members who log in. Roles: ADMIN | EDITOR | VIEWER
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("VIEWER") // ADMIN | EDITOR | VIEWER
  canEditCrm   Boolean  @default(false) // invited to edit CRM; admins always can
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdEntries    PaymentEntry[] @relation("EntryCreatedBy")
  uploadedDocuments Document[]
  auditLogs         AuditLog[]
}

// ---------------------------------------------------------------------------
// A recurring vendor/service the company pays. This is the reusable template
// from which each month's rows are generated.
// ---------------------------------------------------------------------------
model Service {
  id               String   @id @default(cuid())
  name             String // "GitHub", "AWS", "Flespi", …
  vendorType       String   @default("SUBSCRIPTION") // SUBSCRIPTION | SERVICE
  billingFrequency String   @default("MONTHLY") // MONTHLY | ANNUAL | MONTHLY_USAGE | PAY_AS_YOU_GO | ONE_TIME
  currency         String   @default("INR") // primary currency the vendor charges in: INR | USD | EUR
  dueDayOfMonth    Int? // e.g. 20 → due on the 20th; used to auto-fill due dates
  // Optional default amounts (minor units) used to pre-fill a new month's entry.
  defaultInrPaise  Int      @default(0)
  defaultUsdCents  Int      @default(0)
  defaultEurCents  Int      @default(0)
  vendorUrl        String?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entries PaymentEntry[]
}

// ---------------------------------------------------------------------------
// One row per service per month — the heart of the tracker. Mirrors a row of
// the spreadsheet. Values are snapshotted from the Service at generation time
// so later edits to the Service don't rewrite history.
// ---------------------------------------------------------------------------
model PaymentEntry {
  id               String    @id @default(cuid())
  serviceId        String?
  // Snapshot of the service at the time the row was created.
  serviceName      String
  vendorType       String    @default("SUBSCRIPTION")
  billingFrequency String    @default("MONTHLY")
  // Accounting period this row belongs to.
  periodYear       Int
  periodMonth      Int // 1-12
  dueDate          DateTime?
  paymentMadeOn    DateTime?
  status           String    @default("PENDING") // PENDING | PAID | OVERDUE
  // Amounts across the three currencies (minor units). A row may use one or all.
  amountInrPaise        Int  @default(0)
  amountUsdCents        Int  @default(0)
  amountEurCents        Int  @default(0)
  // What was actually paid this month, in INR (the spreadsheet's key column).
  thisMonthPaidInrPaise Int  @default(0)
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  // At most one row per service per period.
  @@unique([serviceId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

// ---------------------------------------------------------------------------
// An invoice/receipt attached to a payment row. Either an uploaded file
// (stored on disk under ./uploads) OR an external link (e.g. Google Drive).
// ---------------------------------------------------------------------------
model Document {
  id           String   @id @default(cuid())
  // A document belongs to exactly one owner: a payment entry, a purchase, a
  // device, or a CRM record (company / contact / deal). All FKs are optional;
  // whichever is set identifies the owner.
  entryId      String?
  purchaseId   String?
  deviceId     String?
  companyId    String?
  contactId    String?
  dealId       String?
  kind         String   @default("FILE") // FILE | LINK
  title        String
  originalName String? // for FILE: the uploaded file name
  storedName   String? // legacy: former on-disk name (files now live in DocumentBlob)
  mimeType     String?
  sizeBytes    Int      @default(0)
  externalUrl  String? // for LINK
  uploadedById String?
  createdAt    DateTime @default(now())

  entry      PaymentEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  purchase   Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal       Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  blob       DocumentBlob?
}

// The raw bytes of an uploaded file, stored in Postgres (bytea). Kept in a
// separate table so listing documents never pulls the file contents into
// memory — only the download route reads it. Storing files in the database
// means uploads persist on serverless hosts (Vercel) and are shared by everyone.
model DocumentBlob {
  id         String   @id @default(cuid())
  documentId String   @unique
  data       Bytes
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Simulated email queue — the alert engine writes here instead of sending.
// Swap src/lib/email.ts for a real provider to go live.
// ---------------------------------------------------------------------------
model EmailOutbox {
  id           String    @id @default(cuid())
  toEmail      String
  toName       String?
  subject      String
  body         String
  type         String // DUE_SOON | OVERDUE | GENERIC
  status       String    @default("QUEUED") // QUEUED | SENT | FAILED
  entryId      String?
  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  error        String?
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// In-app notification for a user (also mirrored to email via queueEmail).
// Generated by src/lib/notify.ts. userId is a bare User id (like ownerId).
// ---------------------------------------------------------------------------
model Notification {
  id         String    @id @default(cuid())
  userId     String // recipient (User.id)
  type       String // TAGGED | TASK_ASSIGNED | TASK_COMPLETED | TASK_OVERDUE | CONTRIBUTOR_ADDED | CONTRIBUTOR_REMOVED | OWNER_CHANGED | PROJECT_COMPLETED | DEAL_INACTIVE | GENERIC
  title      String
  body       String?
  link       String? // in-app URL to the related record
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit trail of who did what.
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// ===========================================================================
// Assets & Procurement — tracking the IoT devices the company buys, who from,
// at what cost, and where each unit is deployed.
// ===========================================================================

// A party the company procures devices from (OEM / distributor / other).
model Supplier {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("OEM") // OEM | DISTRIBUTOR | OTHER
  contactName  String?
  contactEmail String?
  phone        String?
  gstin        String?
  address      String?
  website      String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases Purchase[]
  devices   Device[]
}

// A procurement record — one order/invoice from a supplier.
model Purchase {
  id           String   @id @default(cuid())
  supplierId   String?
  purchaseDate DateTime @default(now())
  reference    String? // PO / invoice number
  currency     String   @default("INR") // INR | USD | EUR
  amountMinor  Int      @default(0) // total cost in minor units
  quantity     Int      @default(1)
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier  Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  devices   Device[]
  documents Document[]

  @@index([purchaseDate])
}

// A single physical device (asset), tracked individually by serial/IMEI.
model Device {
  id           String    @id @default(cuid())
  purchaseId   String?
  supplierId   String?
  companyId    String? // CRM company this unit is deployed to (optional)
  category     String    @default("Device") // free text: GPS Tracker, Gateway, Sensor…
  make         String?
  model        String?
  serialNo     String?   @unique
  imei         String?
  assetTag     String?
  costMinor    Int       @default(0)
  currency     String    @default("INR")
  purchaseDate DateTime?
  status       String    @default("IN_STOCK") // IN_STOCK | DEPLOYED | FAULTY | IN_REPAIR | RETURNED | RETIRED
  // Denormalized snapshot of the current deployment, for fast list rendering.
  location     String?
  assignedTo   String?
  notes        String?
  // Inventory-register template fields — shown 1:1 in the devices table.
  deviceName      String?
  modelNo         String?
  serialImei      String?
  qtyPurchased    Int      @default(1)
  vendorName      String?
  invoiceNo       String?
  projectClient   String?
  statusText      String? // free-text holding/custody status from the register (e.g. "ETO custody")
  installedStatus String? // Yes / No
  installedBy     String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deployments Deployment[]
  documents   Document[]

  @@index([status])
  @@index([imei])
  @@index([companyId])
}

// A movement/assignment event in a device's history.
model Deployment {
  id          String    @id @default(cuid())
  deviceId    String
  action      String    @default("DEPLOYED") // DEPLOYED | RETURNED | TRANSFERRED | REPAIR
  site        String?
  customer    String?
  assignedTo  String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// ===========================================================================
// CRM — companies (customers/partners/vendors), the people at them (contacts),
// the sales opportunities (deals), and a unified activity/timeline model (notes,
// logged interactions, and tasks). Owner/creator are stored as bare User ids
// (like Purchase.createdById) and resolved to names in the UI, so the User
// model stays lean. Enum-like fields are strings; allowed values live in
// src/lib/constants.ts.
// ===========================================================================

// A company the business sells to, partners with, or buys from. The internal
// team member responsible for it is the "account owner" (ownerId).
model Company {
  id               String   @id @default(cuid())
  name             String
  domains          String? // comma-separated web/email domains (e.g. "tesla.com, tesla.in")
  description      String?
  relationshipType String   @default("PROSPECT") // PROSPECT | CUSTOMER | RELATED_PARTY | PARTNER | VENDOR
  source           String? // OUTBOUND | INBOUND | PARTNER_REFERRAL | GROUP_REFERRAL | EXISTING_RELATIONSHIP
  size             String? // SMB | MID_MARKET | ENTERPRISE
  categories       String? // comma-separated free-form tags
  primaryLocation  String?
  teamSize         Int? // customer's employee headcount
  // Optional secondary details, inline-editable on the record.
  email            String?
  phone            String?
  gstin            String?
  active           Boolean  @default(true)
  ownerId          String? // User.id of the account owner (assigned internal member)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  documents  Document[]
  devices    Device[]
  tasks      Task[]
  noteEntries Note[]

  @@index([relationshipType])
  @@index([ownerId])
}

// A person, usually at a Company. Can exist without a company (SetNull).
model Contact {
  id          String   @id @default(cuid())
  companyId   String?
  firstName   String
  lastName    String   @default("")
  email       String?
  phone       String?
  title       String? // job title / role
  isPrimary   Boolean  @default(false) // primary contact for the company
  notes       String?
  ownerId     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealsAsPrimary Deal[]     @relation("DealPrimaryContact")
  activities     Activity[]
  documents      Document[]
  tasks          Task[]
  noteEntries    Note[]

  @@index([companyId])
}

// A sales opportunity moving through the pipeline (Lead → Cash Received).
model Deal {
  id                String    @id @default(cuid())
  title             String
  companyId         String?
  primaryContactId  String?
  stage             String    @default("LEAD") // see DEAL_STAGES in constants.ts
  commercialModel   String? // see COMMERCIAL_MODELS in constants.ts
  amountMinor       Int       @default(0) // deal value in minor units
  arrMinor          Int       @default(0) // annual recurring revenue in minor units
  currency          String    @default("INR") // INR | USD | EUR
  assetsInScope     Int? // number of assets/devices in scope
  packsInScope      String? // free-text description of packs in scope
  nextAction        String?
  source            String? // REFERRAL | WEBSITE | OUTBOUND | EVENT | OTHER
  expectedCloseDate DateTime?
  contractSignedDate DateTime?
  firstInvoiceDate  DateTime?
  firstPaymentDate  DateTime?
  closedAt          DateTime? // set when the stage becomes terminal (Cash Received)
  lossReason        String? // when set, the deal is considered lost
  active            Boolean   @default(true) // false = deal marked inactive
  projectCompletedAt DateTime? // set when the project is marked completed
  notes             String?
  ownerId           String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact Contact?          @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  activities     Activity[]
  documents      Document[]
  tasks          Task[]
  noteEntries    Note[]
  contributors   DealContributor[]
  payments       DealPayment[]

  @@index([stage])
  @@index([companyId])
}

// A contributor on a deal — a team member collaborating alongside the single
// primary owner (Deal.ownerId). userId is a bare User id (resolved to a name in
// the UI), matching the owner/creator convention.
model DealContributor {
  id        String   @id @default(cuid())
  dealId    String
  userId    String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([userId])
}

// A read-only system audit log entry — the single source of truth for the
// lifecycle of a CRM record. Generated automatically by logActivity() on every
// mutation; users cannot create these manually. Anchored to the affected
// company/contact/deal (SetNull so history survives if the parent is deleted).
// Each entry supports threaded comments (ActivityComment).
model Activity {
  id            String   @id @default(cuid())
  // Defaults let `prisma db push` add these required columns to an existing
  // (non-empty) Activity table; new rows always set them explicitly.
  action        String   @default("UPDATED") // CREATED | UPDATED | DELETED | STAGE_CHANGED | OWNER_CHANGED | COMPLETED | REOPENED | INACTIVATED | REACTIVATED | CONTRIBUTOR_ADDED | CONTRIBUTOR_REMOVED | DOCUMENT_ADDED | DOCUMENT_REMOVED | NOTE_ADDED | COMMENTED
  entityType    String   @default("DEAL") // DEAL | COMPANY | CONTACT | TASK | NOTE | DOCUMENT | COLLABORATOR
  entityId      String?
  summary       String   @default("") // human-readable one-line description
  field         String?
  previousValue String?
  newValue      String?
  dealStage     String? // snapshot of the deal's stage at the time (when relevant)
  actorId       String? // User.id who performed the action
  companyId     String?
  contactId     String?
  dealId        String?
  createdAt     DateTime @default(now())

  company  Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal     Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  comments ActivityComment[]

  @@index([companyId])
  @@index([dealId])
  @@index([contactId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// A threaded comment on an Activity entry. Supports replies via parentId and
// @mentions (parsed from body → notifications). Authored by a User.
model ActivityComment {
  id         String   @id @default(cuid())
  activityId String
  authorId   String?
  body       String
  parentId   String? // set for a reply
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  parent   ActivityComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ActivityComment[] @relation("CommentThread")

  @@index([activityId])
}

// A user-authored note on a CRM record (distinct from the read-only Activity
// audit log). Anchored to a company/contact/deal.
model Note {
  id        String   @id @default(cuid())
  body      String
  dealId    String?
  companyId String?
  contactId String?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([companyId])
  @@index([contactId])
}

// A part-payment received against a deal. A deal's agreed value (Deal.amountMinor)
// is often paid in installments (advance / in progress / on completion); each
// received amount is logged here. Total received = sum(amountMinor) per deal.
model DealPayment {
  id          String    @id @default(cuid())
  dealId      String
  amountMinor Int       @default(0)
  currency    String    @default("INR") // copied from the parent deal
  milestone   String    @default("OTHER") // PAYMENT_MILESTONES
  receivedAt  DateTime? // when the money came in
  reference   String? // optional note / txn reference
  authorId    String? // who logged it
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// A unit of work assigned to a team member (internal) or an external person.
// Distinct from the read-only Activity audit log. Owner/assignee/creator are
// bare User ids (resolved to names in the UI), matching Deal.ownerId.
model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?
  assigneeUserId   String? // internal assignee (User.id)
  assigneeExternal String? // external assignee name/email (when not a User)
  priority         String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  status           String    @default("TODO") // BACKLOG | TODO | IN_PROGRESS | DONE | CANCELLED
  dueAt            DateTime?
  completedById    String?
  completedAt      DateTime?
  dealId           String?
  companyId        String?
  contactId        String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assigneeUserId])
  @@index([dealId])
  @@index([dueAt])
}
