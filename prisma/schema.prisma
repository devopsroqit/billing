// roqit Billing — internal recurring-payment tracker
//
// This replaces the old customer-billing model. The company (ROQIT) uses this
// to track the vendors/services IT PAYS every month (GitHub, AWS, Flespi,
// Twilio, …) — exactly like the "ROQIT_Recurring_Payment_Tracker" spreadsheet,
// but multi-user, with roles, and a searchable document library.
//
// NOTE: enum-like fields are stored as plain strings (allowed values live in
// src/lib/constants.ts). This keeps the model portable and easy to evolve; it
// can be tightened to native Postgres enums later if desired.
//
// Money is stored as integer minor units (paise for INR, cents for USD/EUR) to
// avoid floating-point rounding. See src/lib/money.ts.
//
// Database: PostgreSQL. Set DATABASE_URL to your managed Postgres connection
// string (Neon/Supabase). For local dev you can point it at the same database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Office members who log in. Roles: ADMIN | EDITOR | VIEWER
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("VIEWER") // ADMIN | EDITOR | VIEWER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdEntries    PaymentEntry[] @relation("EntryCreatedBy")
  uploadedDocuments Document[]
  auditLogs         AuditLog[]
}

// ---------------------------------------------------------------------------
// A recurring vendor/service the company pays. This is the reusable template
// from which each month's rows are generated.
// ---------------------------------------------------------------------------
model Service {
  id               String   @id @default(cuid())
  name             String // "GitHub", "AWS", "Flespi", …
  vendorType       String   @default("SUBSCRIPTION") // SUBSCRIPTION | SERVICE
  billingFrequency String   @default("MONTHLY") // MONTHLY | ANNUAL | MONTHLY_USAGE | PAY_AS_YOU_GO | ONE_TIME
  currency         String   @default("INR") // primary currency the vendor charges in: INR | USD | EUR
  dueDayOfMonth    Int? // e.g. 20 → due on the 20th; used to auto-fill due dates
  // Optional default amounts (minor units) used to pre-fill a new month's entry.
  defaultInrPaise  Int      @default(0)
  defaultUsdCents  Int      @default(0)
  defaultEurCents  Int      @default(0)
  vendorUrl        String?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entries PaymentEntry[]
}

// ---------------------------------------------------------------------------
// One row per service per month — the heart of the tracker. Mirrors a row of
// the spreadsheet. Values are snapshotted from the Service at generation time
// so later edits to the Service don't rewrite history.
// ---------------------------------------------------------------------------
model PaymentEntry {
  id               String    @id @default(cuid())
  serviceId        String?
  // Snapshot of the service at the time the row was created.
  serviceName      String
  vendorType       String    @default("SUBSCRIPTION")
  billingFrequency String    @default("MONTHLY")
  // Accounting period this row belongs to.
  periodYear       Int
  periodMonth      Int // 1-12
  dueDate          DateTime?
  paymentMadeOn    DateTime?
  status           String    @default("PENDING") // PENDING | PAID | OVERDUE
  // Amounts across the three currencies (minor units). A row may use one or all.
  amountInrPaise        Int  @default(0)
  amountUsdCents        Int  @default(0)
  amountEurCents        Int  @default(0)
  // What was actually paid this month, in INR (the spreadsheet's key column).
  thisMonthPaidInrPaise Int  @default(0)
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  // At most one row per service per period.
  @@unique([serviceId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

// ---------------------------------------------------------------------------
// An invoice/receipt attached to a payment row. Either an uploaded file
// (stored on disk under ./uploads) OR an external link (e.g. Google Drive).
// ---------------------------------------------------------------------------
model Document {
  id           String   @id @default(cuid())
  // A document belongs to exactly one owner: a payment entry, a purchase, a
  // device, or a CRM record (account / contact / deal). All FKs are optional;
  // whichever is set identifies the owner.
  entryId      String?
  purchaseId   String?
  deviceId     String?
  accountId    String?
  contactId    String?
  dealId       String?
  kind         String   @default("FILE") // FILE | LINK
  title        String
  originalName String? // for FILE: the uploaded file name
  storedName   String? // legacy: former on-disk name (files now live in DocumentBlob)
  mimeType     String?
  sizeBytes    Int      @default(0)
  externalUrl  String? // for LINK
  uploadedById String?
  createdAt    DateTime @default(now())

  entry      PaymentEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  purchase   Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  device     Device?       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal       Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  blob       DocumentBlob?
}

// The raw bytes of an uploaded file, stored in Postgres (bytea). Kept in a
// separate table so listing documents never pulls the file contents into
// memory — only the download route reads it. Storing files in the database
// means uploads persist on serverless hosts (Vercel) and are shared by everyone.
model DocumentBlob {
  id         String   @id @default(cuid())
  documentId String   @unique
  data       Bytes
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Simulated email queue — the alert engine writes here instead of sending.
// Swap src/lib/email.ts for a real provider to go live.
// ---------------------------------------------------------------------------
model EmailOutbox {
  id           String    @id @default(cuid())
  toEmail      String
  toName       String?
  subject      String
  body         String
  type         String // DUE_SOON | OVERDUE | GENERIC
  status       String    @default("QUEUED") // QUEUED | SENT | FAILED
  entryId      String?
  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  error        String?
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Audit trail of who did what.
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// ===========================================================================
// Assets & Procurement — tracking the IoT devices the company buys, who from,
// at what cost, and where each unit is deployed.
// ===========================================================================

// A party the company procures devices from (OEM / distributor / other).
model Supplier {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("OEM") // OEM | DISTRIBUTOR | OTHER
  contactName  String?
  contactEmail String?
  phone        String?
  gstin        String?
  address      String?
  website      String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases Purchase[]
  devices   Device[]
}

// A procurement record — one order/invoice from a supplier.
model Purchase {
  id           String   @id @default(cuid())
  supplierId   String?
  purchaseDate DateTime @default(now())
  reference    String? // PO / invoice number
  currency     String   @default("INR") // INR | USD | EUR
  amountMinor  Int      @default(0) // total cost in minor units
  quantity     Int      @default(1)
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier  Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  devices   Device[]
  documents Document[]

  @@index([purchaseDate])
}

// A single physical device (asset), tracked individually by serial/IMEI.
model Device {
  id           String    @id @default(cuid())
  purchaseId   String?
  supplierId   String?
  accountId    String? // CRM account this unit is deployed to (optional)
  category     String    @default("Device") // free text: GPS Tracker, Gateway, Sensor…
  make         String?
  model        String?
  serialNo     String?   @unique
  imei         String?
  assetTag     String?
  costMinor    Int       @default(0)
  currency     String    @default("INR")
  purchaseDate DateTime?
  status       String    @default("IN_STOCK") // IN_STOCK | DEPLOYED | FAULTY | IN_REPAIR | RETURNED | RETIRED
  // Denormalized snapshot of the current deployment, for fast list rendering.
  location     String?
  assignedTo   String?
  notes        String?
  // Inventory-register template fields — shown 1:1 in the devices table.
  deviceName      String?
  modelNo         String?
  serialImei      String?
  qtyPurchased    Int      @default(1)
  vendorName      String?
  invoiceNo       String?
  projectClient   String?
  statusText      String? // free-text holding/custody status from the register (e.g. "ETO custody")
  installedStatus String? // Yes / No
  installedBy     String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deployments Deployment[]
  documents   Document[]

  @@index([status])
  @@index([imei])
  @@index([accountId])
}

// A movement/assignment event in a device's history.
model Deployment {
  id          String    @id @default(cuid())
  deviceId    String
  action      String    @default("DEPLOYED") // DEPLOYED | RETURNED | TRANSFERRED | REPAIR
  site        String?
  customer    String?
  assignedTo  String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// ===========================================================================
// CRM — accounts (companies/customers), the people at them (contacts), the
// sales opportunities (deals), and a unified activity/timeline model (notes,
// logged interactions, and tasks). Owner/creator are stored as bare User ids
// (like Purchase.createdById) and resolved to names in the UI, so the User
// model stays lean. Enum-like fields are strings; allowed values live in
// src/lib/constants.ts.
// ===========================================================================

// A company the business sells to or partners with.
model Account {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("PROSPECT") // CUSTOMER | PROSPECT | PARTNER | OTHER
  industry    String?
  website     String?
  email       String?
  phone       String?
  address     String?
  gstin       String?
  notes       String?
  active      Boolean  @default(true)
  ownerId     String? // User.id of the account owner
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  documents  Document[]
  devices    Device[]

  @@index([type])
}

// A person, usually at an Account. Can exist without an account (SetNull).
model Contact {
  id          String   @id @default(cuid())
  accountId   String?
  firstName   String
  lastName    String   @default("")
  email       String?
  phone       String?
  title       String? // job title / role
  isPrimary   Boolean  @default(false) // primary contact for the account
  notes       String?
  ownerId     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account        Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  dealsAsPrimary Deal[]     @relation("DealPrimaryContact")
  activities     Activity[]
  documents      Document[]

  @@index([accountId])
}

// A sales opportunity moving through pipeline stages to won/lost.
model Deal {
  id                String    @id @default(cuid())
  title             String
  accountId         String?
  primaryContactId  String?
  stage             String    @default("NEW") // NEW | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  amountMinor       Int       @default(0) // deal value in minor units
  currency          String    @default("INR") // INR | USD | EUR
  source            String? // REFERRAL | WEBSITE | OUTBOUND | EVENT | OTHER
  expectedCloseDate DateTime?
  closedAt          DateTime? // set when the stage becomes terminal (WON/LOST)
  notes             String?
  ownerId           String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account        Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  primaryContact Contact?   @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  activities     Activity[]
  documents      Document[]

  @@index([stage])
  @@index([accountId])
}

// A unified timeline record: a free-form note, a logged interaction (call /
// email / meeting), or a task. `status` (OPEN|DONE) and `dueDate` are only
// meaningful for TASK. Anchored to an account and/or a deal (Cascade so they
// are cleaned up with their parent); a contact link is SetNull.
model Activity {
  id          String    @id @default(cuid())
  type        String    @default("NOTE") // NOTE | CALL | EMAIL | MEETING | TASK
  subject     String
  body        String?
  status      String    @default("DONE") // OPEN | DONE
  dueDate     DateTime?
  occurredAt  DateTime  @default(now())
  completedAt DateTime?
  accountId   String?
  contactId   String?
  dealId      String?
  ownerId     String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([dealId])
  @@index([dueDate])
  @@index([status])
}
